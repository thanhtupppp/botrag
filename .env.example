# =============================
# Supabase (required by both Next.js and Docker worker)
# =============================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================
# Google Generative AI (required by Docker worker for embeddings)
# =============================
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# =============================
# Docker Ingest Worker (required by Next.js to communicate with worker)
# =============================
# URL of the running Docker worker (default: http://localhost:3001)
INGEST_WORKER_URL=http://localhost:3001

# Shared secret between Next.js and Docker worker for auth
INGEST_WORKER_SECRET=change-me-to-a-strong-random-secret
